/**
 * WordPress dependencies
 */
import {
	useBlockProps,
	InnerBlocks,
	InspectorControls,
	BlockControls,
} from '@wordpress/block-editor';
import {
	ToolbarGroup,
	PanelBody,
} from "@wordpress/components";
import { __ } from '@wordpress/i18n';

const TEMPLATE = [
	['core/heading', { placeholder: 'Add Title' }],
	['core/paragraph', { placeholder: 'Add Description' }],
];
const ALLOWED_BLOCKS = ['core/heading', 'core/paragraph'];

export default function Edit() {
	const blockProps = useBlockProps( {
		className: '{{namespace}}-{{slug}}',
	} );

	return (
		<>
			<InspectorControls>
				<PanelBody title={__('Settings', '{{namespace}}')}>
					
				</PanelBody>
			</InspectorControls>
			<BlockControls>
				<ToolbarGroup>

				</ToolbarGroup>
			</BlockControls>
			<div {...blockProps}>
				<InnerBlocks template={TEMPLATE} allowedBlocks={ALLOWED_BLOCKS} />
			</div>
		</>
	);
}
